# Copy to .env.local and fill in to enable real Claude-powered agents.
# Without a key, FleetView runs in deterministic SIMULATION mode so the whole
# UI is fully interactive with zero setup.

# Your Anthropic API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Optional: override the model used by agents (defaults to claude-opus-4-8)
FLEETVIEW_MODEL=claude-opus-4-8
